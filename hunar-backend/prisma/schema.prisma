// HUNAR backend — Prisma schema
// Scope: Shafqat Ullah's Module 1 worker-flow modules (Task Contribution/module_1.md lines 808–946).
// Tables for Jobs/Matching, Offers, Visits, Inspection, Repair, Commission, Reviews + minimal User/Category/Location support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  WORKER
  ADMIN
  SUPER_ADMIN
}

enum JobStatus {
  OPEN
  OFFERS_RECEIVED
  OFFER_ACCEPTED
  WORKER_ASSIGNED
  VISIT_SCHEDULED
  VISIT_IN_PROGRESS
  VISIT_COMPLETED
  INSPECTION_DONE
  REPAIR_NEGOTIATING
  REPAIR_APPROVED
  IN_PROGRESS
  COMPLETED
  PAID
  REVIEWED
  CANCELLED
  DISPUTED
}

enum OfferStatus {
  PENDING
  VIEWING
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RepairStatus {
  PROPOSED
  COUNTERED
  ACCEPTED
  REJECTED
}

enum RepairRevisionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PENDING
  RECEIVED
  VERIFIED
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  passwordHash String?
  name         String?
  role         Role     @default(CUSTOMER)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerJobs    ServiceRequest[]    @relation("CustomerJobs")
  selectedJobs    ServiceRequest[]    @relation("SelectedWorkerJobs")
  offers          JobOffer[]
  visits          Visit[]
  repairs         Repair[]
  commissions     Commission[]
  ratings         Review[]            @relation("RevieweeReviews")
  writtenReviews  Review[]            @relation("ReviewerReviews")
  locationTracks  LocationTracking[]

  @@index([role])
}

model ServiceCategory {
  id        String   @id @default(uuid())
  name      String
  nameUrdu  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  jobs ServiceRequest[]

  @@index([isActive])
}

model ServiceRequest {
  id                  String       @id @default(uuid())
  customerId          String
  customer            User         @relation("CustomerJobs", fields: [customerId], references: [id])
  categoryId          String
  category            ServiceCategory @relation(fields: [categoryId], references: [id])
  title               String
  description         String?
  voiceNoteUrl        String?
  images              String[]     @default([])
  latitude            Float
  longitude           Float
  location            Unsupported("geometry(Point, 4326)")?
  address             String
  city                String
  area                String?
  status              JobStatus    @default(OPEN)
  urgency             Urgency      @default(NORMAL)
  suggestedVisitCharge Decimal?    @db.Decimal(10, 2)
  preferredVisitTime  DateTime?
  selectedWorkerId    String?
  selectedWorker      User?        @relation("SelectedWorkerJobs", fields: [selectedWorkerId], references: [id])
  lockedVisitCharge   Decimal?     @db.Decimal(10, 2)
  cancelReason        String?
  cancelledAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  offers         JobOffer[]
  visits         Visit[]
  repairs        Repair[]
  commissions    Commission[]
  reviews        Review[]
  locationTracks LocationTracking[]

  @@index([status])
  @@index([categoryId])
  @@index([customerId])
  @@index([city, area])
  @@index([createdAt])
}

model JobOffer {
  id                 String       @id @default(uuid())
  jobId              String
  job                ServiceRequest @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId           String
  worker             User         @relation(fields: [workerId], references: [id])
  visitCharge        Decimal      @db.Decimal(10, 2)
  message            String?
  status             OfferStatus  @default(PENDING)
  negotiationRound   Int          @default(0)
  negotiationHistory Json?
  lockedAt           DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  visit Visit?

  @@unique([jobId, workerId])
  @@index([jobId])
  @@index([workerId])
}

model Visit {
  id                    String       @id @default(uuid())
  jobId                 String
  job                   ServiceRequest @relation(fields: [jobId], references: [id])
  workerId              String
  worker                User         @relation(fields: [workerId], references: [id])
  offerId               String       @unique
  offer                 JobOffer     @relation(fields: [offerId], references: [id])
  scheduledDate         DateTime
  actualDate            DateTime?
  status                VisitStatus  @default(SCHEDULED)
  diagnosis             String?
  repairPlan            String?
  repairEstimate        Decimal?     @db.Decimal(10, 2)
  inspectionPhotos      String[]     @default([])
  estimatedRepairTimeMin Int?
  inspectionSubmittedAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  repairs Repair[]

  @@index([jobId])
  @@index([workerId])
}

model LocationTracking {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  jobId      String?
  job        ServiceRequest? @relation(fields: [jobId], references: [id])
  latitude   Float
  longitude  Float
  accuracy   Float?
  recordedAt DateTime @default(now())

  @@index([jobId])
  @@index([userId, recordedAt])
}

model Repair {
  id                 String       @id @default(uuid())
  visitId            String
  visit              Visit        @relation(fields: [visitId], references: [id])
  jobId              String
  job                ServiceRequest @relation(fields: [jobId], references: [id])
  workerId           String
  worker             User         @relation(fields: [workerId], references: [id])
  description        String
  amount             Decimal      @db.Decimal(10, 2)
  itemsBreakdown     Json?
  status             RepairStatus @default(PROPOSED)
  negotiationRound   Int          @default(0)
  negotiationHistory Json?
  lockedAmount       Decimal?     @db.Decimal(10, 2)
  lockedAt           DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  revisions RepairRevision[]

  @@index([jobId])
  @@index([visitId])
}

model RepairRevision {
  id             String               @id @default(uuid())
  repairId       String
  repair         Repair               @relation(fields: [repairId], references: [id], onDelete: Cascade)
  proposedAmount Decimal              @db.Decimal(10, 2)
  reason         String
  status         RepairRevisionStatus @default(PENDING_APPROVAL)
  requestedBy    String
  createdAt      DateTime             @default(now())
  decidedAt      DateTime?

  @@index([repairId])
}

model Commission {
  id             String           @id @default(uuid())
  jobId          String           @unique
  job            ServiceRequest   @relation(fields: [jobId], references: [id])
  workerId       String
  worker         User             @relation(fields: [workerId], references: [id])
  visitCharge    Decimal          @db.Decimal(10, 2)
  commissionRate Decimal          @db.Decimal(5, 4)
  amount         Decimal          @db.Decimal(10, 2)
  status         CommissionStatus @default(PENDING)
  screenshotUrl  String?
  paidAt         DateTime?
  verifiedAt     DateTime?
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([workerId, status])
}

model Review {
  id         String        @id @default(uuid())
  jobId      String
  job        ServiceRequest @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User          @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User          @relation("RevieweeReviews", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?
  isVisible  Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@unique([jobId, reviewerId])
  @@index([revieweeId])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}