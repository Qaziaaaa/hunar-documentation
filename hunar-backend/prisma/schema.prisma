generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                 @id @default(uuid())
  phone                   String                 @unique
  passwordHash            String?
  name                    String?
  role                    Role                   @default(CUSTOMER)
  avatarUrl               String?
  isActive                Boolean                @default(true)
  isVerified              Boolean                @default(false)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  commissions             Commission[]
  conversationsAsCustomer Conversation[]         @relation("ConversationCustomer")
  conversationsAsWorker   Conversation[]         @relation("ConversationWorker")
  offers                  JobOffer[]
  locationTracks          LocationTracking[]
  chatMessages            Message[]
  customerPayments        Payment[]              @relation("CustomerPayments")
  workerPayments          Payment[]              @relation("WorkerPayments")
  repairs                 Repair[]
  ratings                 Review[]               @relation("RevieweeReviews")
  writtenReviews          Review[]               @relation("ReviewerReviews")
  serviceAreas            ServiceArea[]
  customerJobs            ServiceRequest[]       @relation("CustomerJobs")
  selectedJobs            ServiceRequest[]       @relation("SelectedWorkerJobs")
  verificationDocuments   VerificationDocument[]
  visits                  Visit[]
  walletLedger            WalletLedger[]
  walletTopUps            WalletTopup[]
  notifications           WorkerNotification[]   @relation("WorkerNotifications")
  workerProfile           WorkerProfile?
  wallet                  WorkerWallet?

  @@index([role])
}

model WorkerProfile {
  userId             String                   @id
  skills             String[]                 @default([])
  experienceYears    Int?
  bio                String?
  isAvailable        Boolean                  @default(false)
  serviceRadiusKm    Int                      @default(10)
  verificationStatus WorkerVerificationStatus @default(NOT_SUBMITTED)
  rejectionReason    String?
  adminNote          String?
  submittedAt        DateTime?
  verifiedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([skills])
  @@index([verificationStatus])
  @@index([isAvailable])
}

model ServiceArea {
  id        String                   @id @default(uuid())
  userId    String
  label     String
  address   String
  latitude  Float
  longitude Float
  location  Unsupported("geometry")?
  createdAt DateTime                 @default(now())
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationDocument {
  id         String                   @id @default(uuid())
  userId     String
  type       VerificationDocumentType
  url        String
  fileName   String?
  mimeType   String?
  uploadedAt DateTime                 @default(now())
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model ServiceCategory {
  id        String           @id @default(uuid())
  name      String
  nameUrdu  String?
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  jobs      ServiceRequest[]

  @@index([isActive])
}

model ServiceRequest {
  id                   String                   @id @default(uuid())
  customerId           String
  categoryId           String
  title                String
  description          String?
  voiceNoteUrl         String?
  images               String[]                 @default([])
  latitude             Float
  longitude            Float
  location             Unsupported("geometry")?
  address              String
  city                 String
  area                 String?
  status               JobStatus                @default(OPEN)
  urgency              Urgency                  @default(NORMAL)
  suggestedVisitCharge Decimal?                 @db.Decimal(10, 2)
  preferredVisitTime   DateTime?
  selectedWorkerId     String?
  lockedVisitCharge    Decimal?                 @db.Decimal(10, 2)
  cancelReason         String?
  cancelledAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  commissions          Commission?
  conversation         Conversation?
  offers               JobOffer[]
  locationTracks       LocationTracking[]
  payments             Payment[]
  repairs              Repair[]
  reviews              Review[]
  category             ServiceCategory          @relation(fields: [categoryId], references: [id])
  customer             User                     @relation("CustomerJobs", fields: [customerId], references: [id])
  selectedWorker       User?                    @relation("SelectedWorkerJobs", fields: [selectedWorkerId], references: [id])
  visits               Visit[]

  @@index([status])
  @@index([categoryId])
  @@index([customerId])
  @@index([city, area])
  @@index([createdAt])
}

model JobOffer {
  id                 String         @id @default(uuid())
  jobId              String
  workerId           String
  visitCharge        Decimal        @db.Decimal(10, 2)
  message            String?
  status             OfferStatus    @default(PENDING)
  negotiationRound   Int            @default(0)
  negotiationHistory Json?
  lockedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  job                ServiceRequest @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker             User           @relation(fields: [workerId], references: [id])
  visit              Visit?

  @@unique([jobId, workerId])
  @@index([jobId])
  @@index([workerId])
}

model Visit {
  id                     String         @id @default(uuid())
  jobId                  String
  workerId               String
  offerId                String         @unique
  scheduledDate          DateTime
  actualDate             DateTime?
  status                 VisitStatus    @default(SCHEDULED)
  diagnosis              String?
  repairPlan             String?
  repairEstimate         Decimal?       @db.Decimal(10, 2)
  inspectionPhotos       String[]       @default([])
  estimatedRepairTimeMin Int?
  inspectionSubmittedAt  DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  repairs                Repair[]
  job                    ServiceRequest @relation(fields: [jobId], references: [id])
  offer                  JobOffer       @relation(fields: [offerId], references: [id])
  worker                 User           @relation(fields: [workerId], references: [id])

  @@index([jobId])
  @@index([workerId])
}

model LocationTracking {
  id         String          @id @default(uuid())
  userId     String
  jobId      String?
  latitude   Float
  longitude  Float
  accuracy   Float?
  recordedAt DateTime        @default(now())
  job        ServiceRequest? @relation(fields: [jobId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@index([jobId])
  @@index([userId, recordedAt])
}

model Repair {
  id                 String           @id @default(uuid())
  visitId            String
  jobId              String
  workerId           String
  description        String
  amount             Decimal          @db.Decimal(10, 2)
  itemsBreakdown     Json?
  status             RepairStatus     @default(PROPOSED)
  negotiationRound   Int              @default(0)
  negotiationHistory Json?
  lockedAmount       Decimal?         @db.Decimal(10, 2)
  lockedAt           DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  job                ServiceRequest   @relation(fields: [jobId], references: [id])
  visit              Visit            @relation(fields: [visitId], references: [id])
  worker             User             @relation(fields: [workerId], references: [id])
  revisions          RepairRevision[]

  @@index([jobId])
  @@index([visitId])
}

model RepairRevision {
  id             String               @id @default(uuid())
  repairId       String
  proposedAmount Decimal              @db.Decimal(10, 2)
  reason         String
  status         RepairRevisionStatus @default(PENDING_APPROVAL)
  requestedBy    String
  createdAt      DateTime             @default(now())
  decidedAt      DateTime?
  repair         Repair               @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([repairId])
}

model Commission {
  id             String           @id @default(uuid())
  jobId          String           @unique
  workerId       String
  visitCharge    Decimal          @db.Decimal(10, 2)
  commissionRate Decimal          @db.Decimal(5, 4)
  amount         Decimal          @db.Decimal(10, 2)
  status         CommissionStatus @default(PENDING)
  screenshotUrl  String?
  paidAt         DateTime?
  verifiedAt     DateTime?
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  job            ServiceRequest   @relation(fields: [jobId], references: [id])
  worker         User             @relation(fields: [workerId], references: [id])

  @@index([workerId, status])
}

model Payment {
  id             String          @id @default(uuid())
  jobId          String
  customerId     String
  workerId       String
  visitCharge    Decimal         @db.Decimal(10, 2)
  amount         Decimal         @db.Decimal(10, 2)
  method         PaymentMethod   @default(COD)
  status         PaymentStatus   @default(INITIATED)
  gateway        PaymentGateway?
  transactionRef String?
  screenshotUrl  String?
  paidAt         DateTime?
  verifiedAt     DateTime?
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customer       User            @relation("CustomerPayments", fields: [customerId], references: [id])
  job            ServiceRequest  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker         User            @relation("WorkerPayments", fields: [workerId], references: [id])

  @@index([jobId])
  @@index([workerId, status])
  @@index([customerId, status])
}

model Review {
  id         String         @id @default(uuid())
  jobId      String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  isVisible  Boolean        @default(true)
  createdAt  DateTime       @default(now())
  job        ServiceRequest @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewee   User           @relation("RevieweeReviews", fields: [revieweeId], references: [id])
  reviewer   User           @relation("ReviewerReviews", fields: [reviewerId], references: [id])

  @@unique([jobId, reviewerId])
  @@index([revieweeId])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Conversation {
  id            String         @id @default(uuid())
  jobId         String         @unique
  customerId    String
  workerId      String
  lastMessage   String?
  lastMessageAt DateTime?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customer      User           @relation("ConversationCustomer", fields: [customerId], references: [id])
  job           ServiceRequest @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker        User           @relation("ConversationWorker", fields: [workerId], references: [id])
  messages      Message[]

  @@index([customerId])
  @@index([workerId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  text           String?
  imageUrl       String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model WorkerNotification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("WorkerNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, type, createdAt])
}

model WorkerWallet {
  userId      String   @id
  balance     Decimal  @default(0) @db.Decimal(10, 2)
  heldBalance Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model WalletLedger {
  id             String           @id @default(uuid())
  userId         String
  type           WalletLedgerType
  amount         Decimal          @db.Decimal(10, 2)
  balanceAfter   Decimal          @db.Decimal(10, 2)
  referenceType  String?
  referenceId    String?
  note           String?
  idempotencyKey String           @unique
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

model WalletTopup {
  id            String      @id @default(uuid())
  workerId      String
  amount        Decimal     @db.Decimal(10, 2)
  screenshotUrl String
  note          String?
  status        TopupStatus @default(PENDING)
  reason        String?
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  worker        User        @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, status, createdAt])
}

model PlatformWallet {
  id               String   @id @default(uuid())
  balance          Decimal  @default(0) @db.Decimal(10, 2)
  totalCommissions Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt        DateTime @updatedAt
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  CUSTOMER
  WORKER
  ADMIN
  SUPER_ADMIN
}

enum WorkerVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  REQUEST_CHANGES
}

enum VerificationDocumentType {
  CNIC_FRONT
  CNIC_BACK
  CERTIFICATE
}

enum JobStatus {
  OPEN
  OFFERS_RECEIVED
  OFFER_ACCEPTED
  WORKER_ASSIGNED
  VISIT_SCHEDULED
  VISIT_IN_PROGRESS
  VISIT_COMPLETED
  INSPECTION_DONE
  REPAIR_NEGOTIATING
  REPAIR_APPROVED
  IN_PROGRESS
  COMPLETED
  PAID
  REVIEWED
  CANCELLED
  DISPUTED
}

enum OfferStatus {
  PENDING
  VIEWING
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RepairStatus {
  PROPOSED
  COUNTERED
  ACCEPTED
  REJECTED
}

enum RepairRevisionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PENDING
  RECEIVED
  VERIFIED
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  MOBILE_WALLET
  COD
}

enum PaymentGateway {
  STRIPE
  JAZZCASH
  EASYPAISA
}

enum NotificationType {
  JOB_MATCHED
  OFFER_ACCEPTED
  OFFER_REJECTED
  COUNTER_OFFER
  COUNTER_ACCEPTED
  VISIT_WINDOW_APPROACHING
  NEW_MESSAGE
  COMMISSION_HELD
  COMMISSION_DEDUCTED
  COMMISSION_REVERSED
  INSUFFICIENT_BALANCE
  TOPUP_SUBMITTED
  TOPUP_APPROVED
  TOPUP_REJECTED
  EARNINGS_RECORDED
  REVIEW_RECEIVED
  VERIFICATION_RESULT
  NEW_OFFER
  VISIT_SCHEDULED
  INSPECTION_SUBMITTED
  REPAIR_ESTIMATE_READY
  REPAIR_APPROVED
  PAYMENT_CONFIRMED
  JOB_COMPLETED
}

enum WalletLedgerType {
  COMMISSION_HELD
  COMMISSION_RELEASED
  COMMISSION_DEDUCTED
  TOPUP_CREDIT
  EARNINGS_CREDIT
  WITHDRAWAL
}

enum TopupStatus {
  PENDING
  APPROVED
  REJECTED
}
