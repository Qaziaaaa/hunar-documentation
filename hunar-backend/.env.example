# HUNAR backend environment example.
# Copy to `.env` and fill real values locally. Never commit `.env`.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL + PostGIS
# Tune the pool for the remote DB's per-query latency: without an explicit limit
# Prisma defaults to ~2xCPU+1, which queues concurrent requests behind the RTT.
DATABASE_URL=postgresql://hunar:hunar@localhost:5432/hunar?schema=public&connection_limit=20&pool_timeout=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TOKEN_TTL=900s
JWT_REFRESH_TOKEN_TTL=2592000s

# Mapbox (geocoding for worker service-areas / job addresses)
MAPBOX_TOKEN=pk.your_mapbox_public_token

# Brevo transactional email (worker registration email OTP)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@your-domain.com
BREVO_SENDER_NAME=WorkerFix

# File storage — MinIO in development, S3 in production (driver auto-selected by NODE_ENV)
STORAGE_DRIVER=minio
STORAGE_BUCKET=hunar-uploads
# S3 (production)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# MinIO (development). Console at http://localhost:9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_USE_SSL=false
# Optional public base URL override (e.g. CloudFront/CDN) that is prepended to object keys
STORAGE_PUBLIC_BASE_URL=

# Cloudinary alternative (set STORAGE_DRIVER=cloudinary to enable)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Platform commission (decimal, e.g. 0.10 = 10%)
COMMISSION_RATE=0.10

# HUNAR commission collection (current mode — WhatsApp screenshot)
COMMISSION_WHATSAPP_NUMBER=+92 314 0837519
COMMISSION_BANK_ACCOUNT=HUNAR Platform Bank Account
# Bounded negotiation: max counter rounds. Keep in sync with the frontend
# NEXT_PUBLIC_MAX_NEGOTIATION_ROUNDS (both default to 5 when unset).
MAX_NEGOTIATION_ROUNDS=5