# HUNAR backend environment example.
# Copy to `.env` and fill real values locally. Never commit `.env`.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://hunar:hunar@localhost:5432/hunar?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TOKEN_TTL=900s
JWT_REFRESH_TOKEN_TTL=2592000s

# Mapbox (geocoding for worker service-areas / job addresses)
MAPBOX_TOKEN=pk.your_mapbox_public_token

# File storage — MinIO in development, S3 in production (driver auto-selected by NODE_ENV)
STORAGE_DRIVER=minio
STORAGE_BUCKET=hunar-uploads
# S3 (production)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# MinIO (development). Console at http://localhost:9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_USE_SSL=false
# Optional public base URL override (e.g. CloudFront/CDN) that is prepended to object keys
STORAGE_PUBLIC_BASE_URL=

# Platform commission (decimal, e.g. 0.10 = 10%)
COMMISSION_RATE=0.10

# HUNAR commission collection (current mode — WhatsApp screenshot)
COMMISSION_WHATSAPP_NUMBER=+92 314 0837519
COMMISSION_BANK_ACCOUNT=HUNAR Platform Bank Account